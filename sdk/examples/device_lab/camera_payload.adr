# camera_payload.adr — готовый эксплоит для игровой механики overflow
# camera_payload.adr — a ready-made exploit for the overflow game mechanic
# Исходник доступен для изучения и изменения в редакторе Blackwire.
# The source can be studied and changed in the Blackwire editor.

# Строка на языке игры. / A string in the game language.
def tr(ru, en):
    if sys.lang() == "en":
        return en
    return ru

if len(sys.args) < 2:
    print(tr("Использование: camera_payload.adr адрес [id уязвимости]", "Usage: camera_payload.adr address [vulnerability id]"))
    print(tr("Поиск цели: probe адрес; подсказки: research адрес id", "Find a target: probe address; hints: research address id"))
    exit(1)
try:
    address = sys.args[1]
    selector = sys.args[2] if len(sys.args) > 2 else null
    profile = net.research(address, selector)
    if profile["kind"] != "overflow":
        print(tr("Инструмент не подходит: нужна механика", "Wrong tool: the target needs mechanic"), profile["kind"])
        print(tr("Подходящий инструмент: market buy", "Matching tool: market buy"), profile["market"])
        exit(1)
    if profile["service"] != "lab_control" or not profile["version"].startswith("1."):
        print(tr("Camera Payload подходит только к lab_control версии 1.x.", "Camera Payload only works against lab_control version 1.x."))
        exit(1)
    selector = profile["id"]
    layout = profile["layout"]
    payload = {"fingerprint": profile["fingerprint"]}
    pad = "A" * (layout["frame_words"] * layout["word_size"])
    entry_address = layout["code_base"] + layout["entry_offset"]
    payload["buffer"] = pad + "|" + str(entry_address) + "|" + layout["canary"]
    check = net.probe(address, selector, payload)
    print(check["feedback"])
    if not check["ok"]:
        exit(1)
    if profile["local"]:
        result = net.privesc(payload, selector)
    else:
        result = net.exploit(address, selector, payload)
    print(result)
    if not result["ok"]:
        exit(1)
except as error:
    print(tr("Эксплоит не выполнен:", "Exploit failed:"), error)
    exit(1)
