# Собственный тип устройства, служба и уязвимости типа и отдельного экземпляра.
def load(event):
    world = plugin.world()
    template = plugin.template("camera")
    template["kind"] = "camera"
    template["org"] = null
    template["router"] = null
    template["domain"] = null
    template["lan_ip"] = null
    template["os"] = "LabOS 1.0"
    template["logs"] = []
    template["mail"] = []
    template["custom_vulns"] = []
    template["services"] = [{"port": 9080, "name": "lab_control", "version": "1.0", "running": true, "banner": "Lab Camera Control", "pages": []}]
    kind = plugin.device_type("smart_camera", template)
    plugin.vulnerability("camera_access", {"device_type": kind, "service": "lab_control", "version_prefix": "1.", "access": "shell", "exploit": {"kind": "overflow", "difficulty": 3, "hint": "Камера хранит адрес служебного обработчика рядом с кадром запроса.", "market": "device_lab:camera_exploit"}})
    plugin.vulnerability("camera_kernel", {"device_type": kind, "local": true, "version_prefix": "LabOS 1.", "access": "root", "exploit": {"kind": "race", "difficulty": 2, "hint": "Подмени ресурс после проверки, до его использования."}})

    plugin.catalog("market", "camera_exploit", {"name": "Camera Payload", "price": 180, "desc": "Эксплоит переполнения камер LabOS. Исходник можно редактировать.", "file": "camera_payload.adr", "code": plugin.asset("camera_payload.adr")})

def create(event):
    world = plugin.world()
    n = plugin.get("created", 0) + 1
    ip = f"198.18.{n // 250}.{n % 250 + 1}"
    host = f"lab-camera-{n}"
    mid = plugin.spawn("device_lab:smart_camera", {"hostname": host, "ip": ip, "up": true})
    plugin.user(mid, "operator", "lab123", false)
    plugin.write(mid, "/etc/lab/device.txt", f"Камера {n}: тестовое устройство SDK")
    plugin.vulnerability(f"single_device_{n}", {"machine": mid, "service": "lab_control", "version_prefix": "1.0", "access": "info"})
    # Узел сразу появляется на игровой карте.
    world = plugin.world()
    world["player"]["known_machines"].append(mid)
    plugin.apply({"player": world["player"]})
    plugin.set("created", n)
    print(f"Создано устройство {host}: {ip}, id={mid}")
    print(f"probe {ip} — удалённые уязвимости типа и экземпляра; локальную исследуй после входа")
    print(f"research -h 3 {ip} device_lab:camera_access — подсказки и параметры")
    print(f"exploit new ~/scripts/camera.adr {ip} device_lab:camera_access — свой код")
    print("Готовый: market buy device_lab:camera_exploit; затем exploit -f ~/scripts/camera_payload.adr -s device_lab:camera_access " + ip)
    print("После входа исследуй device_lab:camera_kernel для локального эксплоита")

def tick(event):
    plugin.set("ticks", plugin.get("ticks", 0) + 1)

def info(event):
    print("Создано устройств:", plugin.get("created", 0))
    print("Тактов мира:", plugin.get("ticks", 0))
