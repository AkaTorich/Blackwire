C = json.loads(plugin.asset("content.json"))

def panel():
    command = "buy " + C["id"] + ":item"
    if C["mode"] == "market":
        command = "market buy " + C["id"] + ":item"
    plugin.window("guide", {"title": C["name"], "text": C["story"] + "\nПокупка в игровом терминале: " + command, "rows": [["Цена", C["price"]], ["Установлено", plugin.get("applied", false)]], "buttons": [{"id": "status", "label": "Показать подсказки"}]})

def load(event):
    if C["mode"] == "hardware":
        plugin.catalog("shop", "item", {"name": C["name"], "desc": C["story"], "price": C["price"]})
        plugin.catalog("achievements", "installed", {"name": C["name"] + ": установлено", "desc": C["story"]})
    else:
        plugin.catalog("market", "item", {"name": C["name"], "desc": C["story"], "price": C["price"], "file": C["file"], "code": C["code"]})
    panel()

def purchased(event):
    if event["id"] != C["id"] + ":item":
        return
    if C["mode"] == "hardware" and not plugin.get("applied", false):
        machine = plugin.machine(0)
        patch = {}
        patch[C["field"]] = machine[C["field"]] + C["amount"]
        plugin.update_machine(0, patch)
        plugin.set("applied", true)
        plugin.unlock(C["id"] + ":installed")
    elif C["mode"] == "market":
        plugin.set("applied", true)
    panel()

def status(event):
    print(C["name"], "-", C["story"])
    if C["mode"] == "hardware":
        print("Покупка:", "buy " + C["id"] + ":item", "| Цена:", C["price"])
        print("Улучшение установлено:", plugin.get("applied", false))
    else:
        print("Покупка:", "market buy " + C["id"] + ":item", "| Цена:", C["price"])
        print("Запуск после покупки:", "adder ~/scripts/" + C["file"])
    panel()

def open_window(event):
    panel()
    plugin.open(C["id"] + ":guide")

def ui(event):
    status(event)
