{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blackwire",
  "version": "0.1.0",
  "identifier": "top.blackwire.game",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Game",
    "shortDescription": "Blackwire — игра про взлом с настоящими окнами",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "resources": {
      "../manual/Blackwire.chm": "Blackwire.chm",
      "../sdk/": "sdk/",
      "../README.md": "README.md"
    }
  }
}
