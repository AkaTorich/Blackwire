# Независимый пакет контента. Все действия происходят внутри вымышленного мира Blackwire.
C = json.loads(plugin.asset("content.json"))

def panel():
    created = plugin.get("created", false)
    lines = C["story"] + "\n" + C["objective"] + "\nСтарт: " + C["id"] + "_start"
    if len(C["nodes"]) > 0:
        first = C["nodes"][0]
        vulnerability = C["id"] + ":" + first["key"] + "_entry"
        lines += "\nСвой эксплоит: research " + first["ip"] + " " + vulnerability
        lines += "\nБольше подсказок: research -h 3 " + first["ip"] + " " + vulnerability
        lines += "\nЗаготовка: exploit new ~/scripts/my_exploit.adr " + first["ip"] + " " + vulnerability
        lines += "\nГотовый инструмент: market buy exp_overflow; запуск: exploit -f ~/scripts/exp_overflow.adr -s " + vulnerability + " " + first["ip"]
    rows = [["Контент создан", created], ["Пройдено", plugin.get("completed", false)]]
    for node in C["nodes"]:
        rows.append([node["hostname"], node["ip"]])
    if C["family"] == "event":
        rows.append(["Фаза инцидента", plugin.get("phase", 0)])
    plugin.window("guide", {"title": C["name"], "text": lines, "rows": rows, "buttons": [{"id": "start", "label": "Старт"}, {"id": "status", "label": "Подсказки"}]})

def load(event):
    for node in C["nodes"]:
        template = plugin.template(node["kind"])
        template["os"] = node["os"]
        template["org"] = null
        template["router"] = null
        template["domain"] = null
        template["lan_ip"] = null
        template["logs"] = []
        template["mail"] = []
        template["custom_vulns"] = []
        template["services"] = [{"port": node["port"], "name": node["service"], "version": "1.0", "running": true, "banner": C["name"] + " / " + node["key"], "pages": []}, {"port": 80, "name": "http", "version": "1.0", "running": true, "banner": C["name"], "pages": []}]
        kind = plugin.device_type(node["key"], template)
        plugin.vulnerability(node["key"] + "_entry", {"device_type": kind, "service": node["service"], "version_prefix": "1.", "access": node["access"], "handler": "hacked"})
        plugin.vulnerability(node["key"] + "_kernel", {"device_type": kind, "local": true, "version_prefix": node["os"], "access": "root"})
    plugin.catalog("achievements", "resolved", {"name": C["name"] + ": раскрыто", "desc": C["objective"]})
    panel()

def start(event):
    if plugin.get("created", false):
        status(event)
        return
    ids = []
    for node in C["nodes"]:
        props = {"hostname": node["hostname"], "ip": node["ip"], "lan_ip": node["lan_ip"], "up": true}
        if len(ids) > 0:
            props["router"] = ids[0]
        mid = plugin.spawn(C["id"] + ":" + node["key"], props)
        ids.append(mid)
        plugin.user(mid, "operator", node["password"], false)
        plugin.write(mid, node["file"], node["text"])
        plugin.write(mid, "/etc/maintenance-note.txt", "Служебная заметка. Служба: " + node["service"] + "\nЗапись: " + node["file"])
        plugin.vulnerability(node["key"] + "_record_leak", {"machine": mid, "service": node["service"], "version_prefix": "1.0", "access": "read:" + node["file"]})
        plugin.page(mid, 80, {"path": "/", "title": C["name"], "html": "<h1>" + C["name"] + "</h1><p>" + node["text"] + "</p>"})
    if len(ids) > 1:
        plugin.org({"name": C["name"], "kind": C["org_kind"], "domain": C["id"].replace("_", "-") + ".hw", "gateway": ids[0], "subnet": C["subnet"], "members": ids, "description": C["story"]})
    plugin.quest("mission", {"title": C["name"], "objective": C["objective"], "reward": C["reward"]})
    world = plugin.world("overview")
    world["player"]["known_machines"].extend(ids)
    plugin.apply({"player": world["player"]})
    plugin.set("machines", ids)
    plugin.set("created", true)
    plugin.mail(0, {"from": C["id"] + "@pack.hw", "subject": C["name"] + ": первая зацепка", "body": C["story"] + "\nОткрой http://" + C["nodes"][0]["ip"] + "/ для первой зацепки.\nПодсказки: " + C["id"] + "_status"})
    if C["family"] == "event":
        plugin.set("phase", 0)
        plugin.timer("incident", 15, "custom.incident", {}, 15)
    panel()
    status(event)

def hacked(event):
    ids = plugin.get("machines", [])
    if event["target"] not in ids:
        return
    valid = false
    for node in C["nodes"]:
        if event["vuln"]["name"] == C["id"] + ":" + node["key"] + "_entry":
            valid = true
    if not valid:
        return
    seen = plugin.get("accessed", [])
    if event["target"] not in seen:
        seen.append(event["target"])
    plugin.set("accessed", seen)
    complete = ids[-1] in seen
    if C["family"] == "case":
        complete = len(seen) == len(ids)
    if complete and plugin.quest_complete(C["id"] + ":mission"):
        plugin.set("completed", true)
        plugin.unlock(C["id"] + ":resolved")
        plugin.mail(0, {"from": C["id"] + "@pack.hw", "subject": C["name"] + ": раскрыто", "body": "Доступ получен. Прочитай сохранённую запись на цели — там подробности. Награду выплатили один раз."})
    panel()

def pulse(event):
    ids = plugin.get("machines", [])
    if len(ids) == 0:
        return
    phase = plugin.get("phase", 0) + 1
    plugin.set("phase", phase)
    mid = ids[0]
    node = C["nodes"][0]
    mode = C["mode"]
    if mode == "outage":
        plugin.update_machine(mid, {"up": phase != 2})
    elif mode == "service" or mode == "window":
        machine = plugin.machine(mid)
        for service in machine["services"]:
            if service["name"] == node["service"]:
                service["running"] = phase != 2
                plugin.service(mid, service)
    elif mode == "credential" or mode == "rollover":
        if phase == 2:
            plugin.user(mid, "operator", node["password"] + "_rotated", false)
    elif mode == "handover":
        plugin.mail(0, {"from": C["id"] + "@pack.hw", "subject": C["name"] + ": смена " + str(phase), "body": "Запись о передаче смены перешла в фазу " + str(phase) + ". Смотри " + node["file"]})
    value = "Фаза инцидента: " + str(phase)
    if mode == "queue":
        value = "Отложенных посылок: " + str(phase * 18)
    elif mode == "battery":
        value = "Резерв батареи, %: " + str(100 - phase * 15)
    elif mode == "telemetry":
        value = "Качество сигнала, %: " + str(95 - phase * 12)
    elif mode == "rotate":
        value = "Поколение резерва: " + str(phase)
    plugin.write(mid, node["file"], node["text"] + "\n" + value)
    plugin.log(mid, "warn", C["name"] + " / " + value)
    plugin.news(C["name"] + ": " + value)
    if phase >= 3:
        plugin.cancel_timer("incident")
    panel()

def status(event):
    print(C["name"])
    print(C["story"])
    print("Задача:", C["objective"])
    if not plugin.get("created", false):
        print("Старт командой:", C["id"] + "_start")
        return
    print("Первая зацепка: http://" + C["nodes"][0]["ip"] + "/")
    print("Запусти probe по каждому доступному адресу. Если файрвол блокирует вход — firewall <адрес>; при промахе повтори и следи за подозрением.")
    print("Пройдено:", plugin.get("completed", false), "| Награда:", C["reward"])
    first = C["nodes"][0]
    vulnerability = C["id"] + ":" + first["key"] + "_entry"
    print("Исследование и подсказки: research -h 3", first["ip"], vulnerability)
    print("Свой код: exploit new ~/scripts/my_exploit.adr", first["ip"], vulnerability)
    print("Готовый инструмент: market buy exp_overflow; затем exploit -f ~/scripts/exp_overflow.adr -s", vulnerability, first["ip"])
    print("Запись дела лежит на последнем узле. Внутренние адреса достижимы через шлюз.")
    if C["family"] == "event":
        print("Фаза инцидента:", plugin.get("phase", 0), "/ 3; меняется каждые 15 игровых секунд.")
    panel()

def open_window(event):
    panel()
    plugin.open(C["id"] + ":guide")

def ui(event):
    if event["action"] == "start":
        start(event)
    else:
        status(event)
