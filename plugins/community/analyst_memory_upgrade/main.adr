C = json.loads(plugin.asset("content.json"))

def tr(ru, en):
    if plugin.lang() == "en":
        return en
    return ru

# Поле на языке игры: name / story, английское — из "<поле>_en".
def F(item, key):
    if plugin.lang() == "en" and item.get(key + "_en", null) != null:
        return item[key + "_en"]
    return item[key]

def panel():
    command = "buy " + C["id"] + ":item"
    if C["mode"] == "market":
        command = "market buy " + C["id"] + ":item"
    plugin.window("guide", {"title": F(C, "name"), "text": F(C, "story") + tr("\nПокупка в игровом терминале: ", "\nBuy in the game terminal: ") + command, "rows": [[tr("Цена", "Price"), C["price"]], [tr("Установлено", "Installed"), plugin.get("applied", false)]], "buttons": [{"id": "status", "label": tr("Показать подсказки", "Show hints")}]})

def load(event):
    if C["mode"] == "hardware":
        plugin.catalog("shop", "item", {"name": F(C, "name"), "desc": F(C, "story"), "price": C["price"]})
        plugin.catalog("achievements", "installed", {"name": F(C, "name") + tr(": установлено", ": installed"), "desc": F(C, "story")})
    else:
        plugin.catalog("market", "item", {"name": F(C, "name"), "desc": F(C, "story"), "price": C["price"], "file": C["file"], "code": C["code"]})
    panel()

def purchased(event):
    if event["id"] != C["id"] + ":item":
        return
    if C["mode"] == "hardware" and not plugin.get("applied", false):
        machine = plugin.machine(0)
        patch = {}
        patch[C["field"]] = machine[C["field"]] + C["amount"]
        plugin.update_machine(0, patch)
        plugin.set("applied", true)
        plugin.unlock(C["id"] + ":installed")
    elif C["mode"] == "market":
        plugin.set("applied", true)
    panel()

def status(event):
    print(F(C, "name"), "-", F(C, "story"))
    if C["mode"] == "hardware":
        print(tr("Покупка:", "Buy:"), "buy " + C["id"] + ":item", tr("| Цена:", "| Price:"), C["price"])
        print(tr("Улучшение установлено:", "Upgrade installed:"), plugin.get("applied", false))
    else:
        print(tr("Покупка:", "Buy:"), "market buy " + C["id"] + ":item", tr("| Цена:", "| Price:"), C["price"])
        print(tr("Запуск после покупки:", "Run after buying:"), "adder ~/scripts/" + C["file"])
    panel()

def open_window(event):
    panel()
    plugin.open(C["id"] + ":guide")

def ui(event):
    status(event)
